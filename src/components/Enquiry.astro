---
import { site } from '../config';
import { fill, pathFor, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
const f = c.fields;
const [before, rest] = f.consent.split('{privacy}');
const [middle, after] = rest.split('{terms}');
const messages = {
  sending: c.sending,
  sent: c.sent,
  error: fill(c.error, { email: site.email }),
  notConnected: fill(c.notConnected, { endpoint: site.formEndpoint, email: site.email, phone: site.phone }),
};
---
<section class="contact" id={d.ids.contact} aria-labelledby="contact-heading">
  <div class="coupon rise">
    <div class="coupon-left">
      <h2 id="contact-heading">{c.heading}</h2>
      <div>
        <p>{c.sentence}</p>
        <p class="direct">{c.or}<br /><a href={site.email.startsWith('[') ? `#${d.ids.contact}` : `mailto:${site.email}`}>{site.email}</a><br /><a href={site.phone.startsWith('[') ? `#${d.ids.contact}` : `tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>
      </div>
    </div>
    <form action={site.formEndpoint} method="post" data-enquiry data-messages={JSON.stringify(messages)} data-endpoint={site.formEndpoint}>
      <input type="hidden" name="language" value={lang} />
      <div class="two">
        <div class="field"><label for="f-name">{f.name}</label><input id="f-name" name="name" type="text" autocomplete="name" required /></div>
        <div class="field"><label for="f-contact">{f.contact}</label><input id="f-contact" name="contact" type="text" autocomplete="email" inputmode="email" required /></div>
      </div>
      <div class="two">
        <div class="field">
          <label for="f-property">{f.property}</label>
          <select id="f-property" name="property_type" required>
            {f.propertyOptions.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-rooms">{f.rooms}</label>
          <select id="f-rooms" name="rooms" required>
            {f.roomsOptions.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
      </div>
      <div class="field"><label for="f-city">{f.city}</label><input id="f-city" name="city" type="text" autocomplete="address-level2" required /></div>
      <div class="field"><label for="f-message">{f.message}</label><textarea id="f-message" name="message" rows="4" placeholder={f.messagePlaceholder}></textarea></div>
      <label class="consent">
        <input type="checkbox" name="consent" value="yes" required />
        <span>{before}<a href={pathFor(lang, 'privacy')}>{f.consentPrivacy}</a>{middle}<a href={pathFor(lang, 'terms')}>{f.consentTerms}</a>{after}</span>
      </label>
      <button class="submit" type="submit">{c.submit}</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
