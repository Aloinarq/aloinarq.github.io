---
import { Picture } from 'astro:assets';
import onDresser from '../assets/shots/from-bed-dresser.jpg';
import onWall from '../assets/shots/from-bed-wall.jpg';
import { ROOM, STAND, SIZES, DEFAULT_SIZE, DEFAULT_X, SLIDE, compute, cm, cm1 } from '../scripts/fit';
import { fill, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const f = d.fit;
const locale = { ro: 'ro-RO', hu: 'hu-HU', en: 'en-GB' }[lang];
const Y = (h: number) => ROOM.ceiling - h; // height above floor -> svg y
const r = compute(DEFAULT_SIZE, DEFAULT_X);
const strings = {
  locale,
  status: f.status,
  things: f.things,
  detail: f.detail,
  overhang: f.overhang,
  noOverhang: f.noOverhang,
  dresser: cm1(ROOM.dresser.x1 - ROOM.dresser.x0, locale),
};
const midY = (r.y0 + r.y1) / 2;
---
<section class="section fit" id={d.ids.fit} aria-labelledby="fit-heading">
  <div class="fit-top">
    <h2 id="fit-heading" class="rise">{f.heading}</h2>
    <p class="rise" style="--i:1">{f.intro}</p>
  </div>

  <div class="fit-board rise" style="--i:2" data-fit data-strings={JSON.stringify(strings)}>
    <svg class="fit-svg" viewBox="-130 30 342 252" role="img" aria-labelledby="fit-svg-title">
      <title id="fit-svg-title">{f.drawingLabel}</title>
      <rect x="-130" y={Y(ROOM.ceiling)} width={ROOM.corner + 130} height={ROOM.ceiling} fill="#e1e6dc" />
      <rect x={ROOM.corner} y="20" width="8" height="262" fill="#293e42" />
      <rect x="-130" y={Y(0)} width="350" height="9" fill="#293e42" />
      <!-- vanity, hutch and the round mirror -->
      <rect x={ROOM.vanity.x0} y={Y(ROOM.vanity.top)} width={ROOM.vanity.x1 - ROOM.vanity.x0} height={ROOM.vanity.top} fill="#bcc9d5" />
      <rect x={ROOM.hutch.x0} y={Y(ROOM.hutch.y1)} width={ROOM.hutch.x1 - ROOM.hutch.x0} height={ROOM.hutch.y1 - ROOM.hutch.y0} fill="#bcc9d5" />
      <circle cx={ROOM.mirror.cx} cy={Y(ROOM.mirror.cy)} r={ROOM.mirror.r} fill="#d9e2e9" stroke="#73837d" stroke-width="1.2" />
      <rect x={ROOM.mirror.cx - 2} y={Y(ROOM.mirror.y0 + 3)} width="4" height="3" fill="#73837d" />
      <!-- dresser -->
      <rect x={ROOM.dresser.x0} y={Y(ROOM.dresser.top)} width={ROOM.dresser.x1 - ROOM.dresser.x0} height={ROOM.dresser.top} fill="#b8cbbd" />
      <!-- door: casing in the plan's door colour, the opening behind it -->
      <rect x={ROOM.door.x0} y={Y(ROOM.door.top)} width={ROOM.door.x1 - ROOM.door.x0} height={ROOM.door.top} fill="#cfcabd" />
      <rect x={ROOM.door.casingX0} y={Y(ROOM.door.casingTop)} width={ROOM.door.x0 - ROOM.door.casingX0} height={ROOM.door.casingTop} fill="#be753d" />
      <rect x={ROOM.door.x1} y={Y(ROOM.door.casingTop)} width={ROOM.door.casingX1 - ROOM.door.x1} height={ROOM.door.casingTop} fill="#be753d" />
      <rect x={ROOM.door.casingX0} y={Y(ROOM.door.casingTop)} width={ROOM.door.casingX1 - ROOM.door.casingX0} height={ROOM.door.casingTop - ROOM.door.top} fill="#be753d" />
      <g class="names" font-size="5.6" fill="#293e42">
        <text x={ROOM.hutch.x0 + 3} y={Y(ROOM.hutch.y1) - 3}>{f.labels.vanity}</text>
        <text x={ROOM.dresser.x0 + 3} y={Y(ROOM.dresser.top) + 9}>{f.labels.dresser}</text>
        <text x={ROOM.door.x0 + 4} y={Y(ROOM.door.top) + 10}>{f.labels.door}</text>
      </g>
      <!-- the TV, in the viewer's "added by you" yellow -->
      <g id="fit-tv">
        <rect id="fit-panel" x={r.x0} y={Y(r.y1)} width={r.w} height={r.h} fill="#f0d28c" stroke="#293e42" stroke-width="1.4" />
        <rect id="fit-neck" x={r.xc - 2.5} y={Y(r.y0)} width="5" height={STAND.lift} fill="#293e42" />
        <rect id="fit-base" x={r.xc - STAND.base / 2} y={Y(ROOM.dresser.top + 1.4)} width={STAND.base} height="1.4" fill="#293e42" />
      </g>
      <g class="dims" font-size="6" font-weight="800" fill="#293e42">
        <rect id="gapbar-mirror" x={ROOM.mirror.x1} y={Y(midY) - 1} width={Math.max(0, r.gapMirror)} height="2" fill="#8a2f1c" />
        <text id="gaptext-mirror" x={ROOM.mirror.x1 + Math.max(0, r.gapMirror) / 2} y={Y(midY) - 5} text-anchor="middle">{cm(r.gapMirror, locale)} cm</text>
        <rect id="gapbar-door" x={r.x1} y={Y(midY) - 1} width={Math.max(0, r.gapDoor)} height="2" fill="#293e42" />
        <text id="gaptext-door" x={r.x1 + Math.max(0, r.gapDoor) / 2} y={Y(midY) - 5} text-anchor="middle">{cm(r.gapDoor, locale)} cm</text>
      </g>
    </svg>

    <div class="fit-controls">
      <fieldset class="sizes">
        <legend>{f.sizesLabel}</legend>
        {f.sizes.map((label, i) => (
          <button type="button" data-size={i} aria-pressed={i === DEFAULT_SIZE ? 'true' : 'false'}>
            {label}<small>{f.sizeNotes[i]}</small>
          </button>
        ))}
      </fieldset>
      <div class="slider">
        <label for="fit-x">{f.slider}</label>
        <input id="fit-x" type="range" min={SLIDE.min.toFixed(1)} max={SLIDE.max.toFixed(1)} step="0.5" value={DEFAULT_X.toFixed(2)} />
      </div>
    </div>

    <div class="readout">
      <p class="status live" aria-live="polite" data-tone={r.tone} id="fit-status">{fill(f.status.tight, { gap: cm(r.gapMirror, locale), near: f.things.mirror.near })}</p>
      <p class="live" id="fit-detail">{fill(f.detail, { w: cm1(r.w, locale), h: cm1(r.h, locale), dresser: strings.dresser, mirror: cm(r.gapMirror, locale), door: cm(r.gapDoor, locale) })} {fill(f.overhang, { left: cm1(r.overLeft, locale), right: cm1(r.overRight, locale) })}</p>
    </div>
    <p class="fit-note">{f.note}</p>
  </div>

  <div class="fit-compare">
    <h3 class="rise">{f.compareHeading}</h3>
    <div class="pair">
      {[onDresser, onWall].map((img, i) => (
        <figure class="rise" style={`--i:${i + 1}`}>
          <Picture src={img} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 899px) 100vw, 48vw" alt={f.compare[i].alt} loading="lazy" />
          <figcaption>{f.compare[i].caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
