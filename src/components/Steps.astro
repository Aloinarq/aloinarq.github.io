---
import { Image, getImage } from 'astro:assets';
import top from '../assets/shots/view-top.jpg';
import front from '../assets/shots/view-front.jpg';
import side from '../assets/shots/view-side.jpg';
import tvPoster from '../assets/shots/place-poster.jpg';
import { site } from '../config';
import { fill, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const views = [top, front, side];
const poster = await getImage({ src: tvPoster, width: 1200, format: 'webp', quality: 78 });
// Step 1's picture: an example enquiry, written entirely from the enquiry form's own wording.
const c = d.contact;
const exampleProperty = c.fields.propertyOptions[0];
const exampleCity = site.city[lang];
const subject = fill(c.subject, { property: exampleProperty, city: exampleCity });
---
<!-- Four steps. On a large enough screen main.ts pins the stage for one screen-height of scroll per step
     and shows one step at a time, with the progress markers following; on phones, short windows, with
     reduced motion or without script, the steps are a plain list. -->
<section class="section how" id={d.ids.how} aria-labelledby="how-heading" data-how style={`--steps:${d.how.steps.length}`}>
  <div class="how-track">
    <div class="how-stage">
      <div class="how-col">
        <h2 id="how-heading" class="rise">{d.how.heading}</h2>
        <div class="how-progress" aria-hidden="true">
          {d.how.steps.map((_, i) => <span data-mark={i}>{i + 1}</span>)}
          <span class="how-bar"><span></span></span>
        </div>
        <ol class="stages">
          <li class="rise" data-step="0">
            <p><strong>{d.how.steps[0].lead}</strong> {d.how.steps[0].text}</p>
            <figure class="evidence" aria-hidden="true">
              <div class="mail">
                <p class="mail-to">{site.email}</p>
                <p class="mail-subject">{subject}</p>
                <dl class="mail-fields">
                  <div><dt>{c.mailLabels.property}</dt><dd>{exampleProperty}</dd></div>
                  <div><dt>{c.mailLabels.rooms}</dt><dd>2</dd></div>
                  <div><dt>{c.mailLabels.city}</dt><dd>{exampleCity}</dd></div>
                </dl>
                <p class="mail-message">{c.fields.messagePlaceholder}</p>
              </div>
            </figure>
          </li>
          <li class="rise" data-step="1">
            <p><strong>{d.how.steps[1].lead}</strong> {d.how.steps[1].text}</p>
            <figure class="evidence">
              <div class="paper" data-ui lang="ro" aria-describedby="contract-caption">
                <p class="doc-title">CONTRACT DE PRESTĂRI SERVICII ȘI CESIUNE A DREPTURILOR PATRIMONIALE DE AUTOR</p>
                <p class="doc-no">nr. <span class="blank"></span> din <span class="blank"></span></p>
                <p class="doc-parties">Între <span class="blank"></span>, în calitate de <b>Beneficiar</b>, și Levente <span class="blank"></span>, persoană fizică, în calitate de <b>Prestator</b>, s-a încheiat prezentul contract.</p>
              </div>
              <figcaption id="contract-caption">{d.how.contractLabel}</figcaption>
            </figure>
          </li>
          <li class="rise" data-step="2">
            <p><strong>{d.how.steps[2].lead}</strong> {d.how.steps[2].text}</p>
            <figure class="evidence">
              <div class="views">
                {views.map((v, i) => <Image src={v} width={360} densities={[1, 2]} alt={d.how.viewAlts[i]} loading="lazy" style={`--ratio:${(v.width / v.height).toFixed(4)}`} />)}
              </div>
              <figcaption>{d.how.viewsLabel}</figcaption>
            </figure>
          </li>
          <li class="rise" data-step="3">
            <p><strong>{d.how.steps[3].lead}</strong> {d.how.steps[3].text}</p>
            <figure class="evidence stage-video">
              <video data-lazy-video data-src="/media/place.mp4" poster={poster.src} muted loop playsinline preload="none" width="1440" height="844" aria-label={d.how.videoLabel}></video>
              <figcaption>{d.how.videoLabel}</figcaption>
            </figure>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>
